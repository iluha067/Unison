# Unison server configuration (copy to .env and source it, or pass via systemd)
PORT=3000
HOST=0.0.0.0

# Strong shared key. The plugin must send the same value as "API key".
API_KEY=change-me-to-a-long-random-string

# Reject every client unless a valid API_KEY is presented (on by default when
# API_KEY is set; set to true to require it even without a key configured).
REQUIRE_AUTH=false

# Optional second factor, shared by everyone in a room.
# ROOM_TOKEN=room-password

DATA_DIR=/opt/unison/data
PLUGIN_DIR=/opt/unison/plugin

# Comma-separated origins allowed to fetch /plugin/* ; empty = no CORS header,
# "*" = any origin. Keep empty unless you host the plugin files for the browser.
CORS_ORIGINS=

LOG_LEVEL=info

# Limits (bytes unless noted)
MAX_FILE_BYTES=8388608
MAX_ROOM_BYTES=536870912
MAX_CLIENTS_PER_ROOM=5
MAX_HIST=20
HIST_MAX_BYTES=262144
HIST_TOTAL_BYTES=524288

# Rate limiting: burst and sustained refill per second, per client.
RATE_BURST=300
RATE_REFILL_PER_SEC=40

# Drop an empty room from memory after this many ms (0 = keep forever).
IDLE_UNLOAD_MS=1800000
